          RowBox[{"{", 
           RowBox[{"ii", ",", "n"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"jj", ",", "1"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"ii", "=", "1"}], ",", 
         RowBox[{"ii", "\[LessEqual]", "n"}], ",", 
         RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", 
