   RowBox[{
   "modulo", " ", "que", " ", "gera", " ", "instancia", " ", "para", " ", "o",
     " ", "MDGP"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GeraInstancia", "[", 
    RowBox[{"n_", ",", " ", "dc_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "teta", ",", " ", "r", ",", " ", "X", ",", " ", "A", ",", " ", "Dij", 
       ",", " ", "Dijs", ",", " ", "Q", ",", " ", "ind"}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"teta", " ", "=", " ", "1.91"}], ";", "\n", "   ", 
      RowBox[{"(*", 
       RowBox[{"angulo", " ", 
        RowBox[{"planar", ":", 
         RowBox[{"109.4", " ", "graus"}]}]}], "*)"}], "\n", "   ", 
      RowBox[{"r", " ", "=", " ", "1.526"}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"comprimento", " ", "em", " ", 
          RowBox[{"Angstron", "[", "A", "]"}]}], ":", 
         RowBox[{"1", " ", "A"}]}], "=", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}], " ", "m"}]}], "*)"}], "\n", "   ", 
      RowBox[{"X", " ", "=", " ", 
       RowBox[{"GeraBackbone", "[", 
        RowBox[{"n", ",", " ", "teta", ",", " ", "r"}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "A", ",", " ", "Dij", ",", " ", "Dijs", ",", " ", "Q", ",", " ", 
         "ind"}], "}"}], " ", "=", " ", 
       RowBox[{"SelecionaAtomos", "[", 
        RowBox[{"X", ",", " ", "dc", ",", " ", "n"}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{
        "X", ",", " ", "A", ",", " ", "Dij", ",", " ", "Dijs", ",", " ", "Q", 
         ",", " ", "ind"}], "}"}], "]"}], ";"}]}], "\n", "   ", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"ccf5db52-5f71-42c5-b4ac-9bec3f24e788"]
}, Closed]],

Cell[CellGroupData[{

Cell["Calcula o erro LDE (Largest Distance Error)", "Section",
 CellFrame->{{0, 0}, {0, 
  2}},ExpressionUUID->"825621dc-e718-47b1-a205-3204dc81987c"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "ClearAll", "[", "\[IndentingNewLine]", "erroLDE", "\[IndentingNewLine]", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"modulo", " ", "erro"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"erroLDE", "[", 
      RowBox[{"x_", ",", "D_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"LDE", ",", "m", ",", "n", ",", "ii", ",", "jj"}], "}"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"LDE", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"m", "=", 
         RowBox[{"Length", "[", "D", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"x", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", ";;"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"ii", "=", "1"}], ",", 
          RowBox[{"ii", "\[LessEqual]", "n"}], ",", 
          RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"jj", "=", 
              RowBox[{"ii", "+", "1"}]}], ",", 
             RowBox[{"jj", "\[LessEqual]", "n"}], ",", " ", 
             RowBox[{"jj", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"LDE", "=", 
               RowBox[{"LDE", "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "/", 
                   RowBox[{"D", "[", 
                    RowBox[{"[", 
                    RowBox[{"ii", ",", "jj"}], "]"}], "]"}]}], ")"}], "*", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"x", "[", 
                    RowBox[{"[", 
                    RowBox[{"ii", ",", ";;"}], "]"}], "]"}], "-", 
                    RowBox[{"x", "[", 
                    RowBox[{"[", 
                    RowBox[{"jj", ",", ";;"}], "]"}], "]"}]}], "]"}], "-", 
                   RowBox[{"D", "[", 
                    RowBox[{"[", 
                    RowBox[{"ii", ",", "jj"}], "]"}], "]"}]}], "]"}]}]}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"LDE", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", "m"}], ")"}], "*", "LDE"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "LDE", "]"}], ";"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->"63318416-6122-4e5b-b5bf-\
10840fb10de4"]
}, Closed]],

Cell[CellGroupData[{

Cell["Computa a interse\[CCedilla]\[ATilde]o entre esferas", "Section",
 CellFrame->{{0, 0}, {0, 
  2}},ExpressionUUID->"f46e8a66-8a82-4fef-b607-dfae2d0d7184"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", 
    RowBox[{"qrd", ",", "IntersEsferas"}], "\[IndentingNewLine]", "]"}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "modulo", " ", "que", " ", "computa", " ", "decomposicao", " ", "QR"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qrd", "[", 
     RowBox[{"mat_", "?", "MatrixQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"r", "=", "mat"}], ",", "h", ",", "m", ",", "n", ",", "q", 
        ",", "v"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", "n"}], "}"}], "=", 
        RowBox[{"Dimensions", "[", "r", "]"}]}], ";", 
       RowBox[{"q", "=", 
        RowBox[{"IdentityMatrix", "[", "m", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"v", "=", 
           RowBox[{"PadLeft", "[", 
            RowBox[{
             RowBox[{"r", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"kk", ";;"}], ",", "kk"}], "]"}], "]"}], ",", "m"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"h", "=", 
           RowBox[{"ReflectionMatrix", "[", 
            RowBox[{"v", "-", 
             RowBox[{"SparseArray", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"kk", "\[Rule]", 
                 RowBox[{"Norm", "[", "v", "]"}]}], "}"}], ",", "m"}], 
              "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"q", "=", 
           RowBox[{"q", ".", "h"}]}], ";", 
          RowBox[{"r", "=", 
           RowBox[{"h", ".", "r"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"kk", ",", "n"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"q", ",", "r"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "modulo", " ", "que", " ", "computa", " ", "a", " ", "intersecao", " ", 
    "entre", " ", "esferas"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IntersEsferas", "[", 
    RowBox[{"n_", ",", "m_", ",", "kk_", ",", "A_", ",", "d_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[CapitalAHat]", ",", "ii", ",", "jj", ",", "Q", ",", "R", ",", "c", 
       ",", "cbar", ",", "Rhat", ",", "Rhat1", ",", "c1", ",", 
       "\[IndentingNewLine]", "Rhat2", ",", "c2", ",", "y", ",", "del", ",", 
       "z", ",", "w", ",", "x1", ",", "x2", ",", "z1", ",", "z2", ",", "w1", 
       ",", "w2", ",", "erro", ",", "aux", ",", "z0"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"calcula", " ", "a", " ", "matriz", " ", "\[CapitalAHat]"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalAHat]", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"jj", "=", "1"}], ",", 
        RowBox[{"jj", "\[LessEqual]", 
         RowBox[{"m", "-", "1"}]}], ",", 
        RowBox[{"jj", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalAHat]", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "jj"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "jj"}], "]"}], "]"}], "-", 
           RowBox[{"A", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "m"}], "]"}], "]"}]}]}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"resolve", " ", "o", " ", "sistema", " ", 
         RowBox[{"\[CapitalAHat]", "^", "t"}], " ", "xbar"}], "=", 
        RowBox[{
        "c", " ", "via", " ", "decomposicao", " ", "QR", " ", "de", " ", 
         "\[CapitalAHat]"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Q", ",", "R"}], "}"}], "=", 
       RowBox[{"qrd", "[", "\[CapitalAHat]", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"computa", " ", "vetor", " ", "c"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"jj", ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cbar", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"jj", ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"ii", "=", "1"}], ",", 
        RowBox[{"ii", "\[LessEqual]", 
         RowBox[{"m", "-", "1"}]}], ",", 
        RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", 
            RowBox[{"ii", ",", "1"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}], ")"}], "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"d", "[", 
               RowBox[{"[", 
                RowBox[{"ii", ",", "1"}], "]"}], "]"}], "^", "2"}], "-", 
             RowBox[{
              RowBox[{"d", "[", 
               RowBox[{"[", 
                RowBox[{"m", ",", "1"}], "]"}], "]"}], "^", "2"}], "-", 
             RowBox[{
              RowBox[{"Norm", "[", 
               RowBox[{"\[CapitalAHat]", "[", 
                RowBox[{"[", 
                 RowBox[{";;", ",", "ii"}], "]"}], "]"}], "]"}], "^", "2"}]}],
             ")"}]}]}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Rhat", "=", 
       RowBox[{"R", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"1", ";;", "kk"}], ",", ";;"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Rhat1", "=", 
       RowBox[{"Rhat", "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", 
          RowBox[{"1", ";;", "kk"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"c1", "=", 
       RowBox[{"c", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"1", ";;", "kk"}], ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"kk", "\[NotEqual]", 
         RowBox[{"m", "-", "1"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Rhat2", "=", 
          RowBox[{"Rhat", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", 
             RowBox[{
              RowBox[{"kk", "+", "1"}], ";;", 
              RowBox[{"m", "-", "1"}]}]}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"c2", "=", 
          RowBox[{"c", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"kk", "+", "1"}], ";;", 
              RowBox[{"m", "-", "1"}]}], ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"y", "=", 
          RowBox[{"LinearSolve", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "Rhat1", "]"}], ",", "c1"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Transpose", "[", "Rhat2", "]"}], ".", "y"}], "-", 
              "c2"}], "]"}], ">", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "6"}], ")"}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
            "Print", "[", 
             "\"\<> > y n\[ATilde]o pertence a imagem de Rhat^t < <\>\"", 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"Print", "[", "\"\<> > Intersecao vazia < <\>\"", "]"}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"Return", "[", 
             RowBox[{"{", "}"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
          ";"}], "\[IndentingNewLine]", ",", 
        RowBox[{
         RowBox[{"y", "=", 
          RowBox[{"LinearSolve", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "Rhat", "]"}], ",", "c"}], "]"}]}], 
         ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "computa", " ", "argumento", " ", "da", " ", "raiz", " ", "quadrada"}],
        "*)"}], "\[IndentingNewLine]", 
      RowBox[{"del", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"d", "[", 
             RowBox[{"[", 
              RowBox[{"m", ",", "1"}], "]"}], "]"}], "^", "2"}], "-", 
           RowBox[{
            RowBox[{"Norm", "[", "y", "]"}], "^", "2"}]}], "]"}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "12"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"del", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"d", "[", 
             RowBox[{"[", 
              RowBox[{"m", ",", "1"}], "]"}], "]"}], "^", "2"}], "-", 
           RowBox[{
            RowBox[{"Norm", "[", "y", "]"}], "^", "2"}]}], "]"}]}], ";"}], 
       "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"del", "<", "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<  > Intersecao vazia: \[Delta] < 0\>\"", "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"Break", "[", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"del", "\[Equal]", "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"z", "=", "0"}], ";", "\[IndentingNewLine]", 
         RowBox[{"w", "=", "y"}], ";", "\[IndentingNewLine]", 
         RowBox[{"w", "=", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"w", ",", 
            RowBox[{"{", "z", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"x1", "=", 
          RowBox[{
           RowBox[{"Q", ".", "w"}], "+", 
           RowBox[{"A", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "m"}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"x2", "=", "x1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<> > Solu\[CCedilla]\[ATilde]o: x = \>\"", ",", "x1"}], "]"}],
            ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"erro", "=", 
          RowBox[{"erroMDE", "[", 
           RowBox[{"x1", ",", "A", ",", "d", ",", "m"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"del", ">", "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"n", "-", "kk"}], ">", "1"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", "\"\<>> caso de (n-k)-esferas\>\"", "]"}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"Break", "[", "]"}], ";"}], "\[IndentingNewLine]", ",", 
           RowBox[{
            RowBox[{"z1", "=", 
             RowBox[{"Sqrt", "[", "del", "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"z2", "=", 
             RowBox[{"-", 
              RowBox[{"Sqrt", "[", "del", "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"w1", "=", "y"}], ";", "\[IndentingNewLine]", 
            RowBox[{"w1", "=", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"w1", ",", 
               RowBox[{"{", "z1", "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"w2", "=", "y"}], ";", "\[IndentingNewLine]", 
            RowBox[{"w2", "=", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"w2", ",", 
               RowBox[{"{", "z2", "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"x1", "=", 
             RowBox[{
              RowBox[{"Q", ".", "w1"}], "+", 
              RowBox[{"A", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "m"}], "]"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"x2", "=", 
             RowBox[{
              RowBox[{"Q", ".", "w2"}], "+", 
              RowBox[{"A", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "m"}], "]"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"erro", "=", 
             RowBox[{"erroMDE", "[", 
              RowBox[{"x1", ",", "A", ",", "d", ",", "m"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{
             "\"\<Solu\[CCedilla]\[OTilde]es: x1 = \>\"", ",", "x1", ",", 
              "\"\<,  x2 = \>\"", ",", "x2"}], "]"}], ";"}], "*)"}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x1", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"x2", "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "1"}], "]"}], "]"}]}], "}"}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "Input",Ex\
pressionUUID->"e3a3ea32-008e-4e17-a19f-b3dcad75ca28"]
}, Closed]],

Cell[CellGroupData[{

Cell["Modulo edmsph[]", "Section",
 CellFrame->{{0, 0}, {0, 
  2}},ExpressionUUID->"64540adf-ab58-4749-8e4a-ab35939ada2d"],

Cell[BoxData[{
