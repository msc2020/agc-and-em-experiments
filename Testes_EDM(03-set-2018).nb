  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DefEsferas", "[", 
     RowBox[{"K_", ",", "I_", ",", "x_", ",", "D_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nx", ",", "n", ",", "A", ",", "d", ",", "ii"}], "}"}], ",", 
      "\[IndentingNewLine]", 
